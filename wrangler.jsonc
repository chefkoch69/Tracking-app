// Cloudflare Worker für „Mein Befinden“: liefert die App aus (alle Dateien im Skript eingebettet),
// schützt sie mit einem Passwort (Geheimnis PASSWORT, im Cloudflare-Dashboard festgelegt) und
// speichert die Tagebuch-Daten in einer D1-Datenbank; Anmeldung und Health-Eingang im KV-Speicher.
// Veröffentlichen: npm run deploy – braucht ein Cloudflare-API-Token (Workers bearbeiten).
{
  "name": "mein-befinden",
  "main": "dist-worker/worker.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "DATA", "id": "cf53058564dc4e0cb81140f36998efb5" }],
  // Tagebuch-Daten: D1-Datenbank (SQLite) in Westeuropa, mit automatischer Wiederherstellung bis 30 Tage.
  "d1_databases": [{ "binding": "DB", "database_name": "mein-befinden-db", "database_id": "65287533-1d00-4944-98ef-8c4242883f4c" }]
}
